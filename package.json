    "@remotion/cli": "4.0.484",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
